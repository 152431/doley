.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: #f5f7fa;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon .iconfont {
  font-size: 80rpx;
  color: #d9d9d9;
}

.empty-title {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 32rpx;
}

.empty-action {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 40rpx;
}

.empty-action text {
  font-size: 28rpx;
  color: #ffffff;
}

.iconfont {
  font-family: "iconfont";
}
