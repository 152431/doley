.container {
  padding-bottom: 120rpx;
}

.monitor-header {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  margin: -24rpx -24rpx 24rpx -24rpx;
  padding: 24rpx;
}

.header-stats {
  display: flex;
  gap: 20rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon .iconfont {
  font-size: 36rpx;
  color: #ffffff;
}

.stat-icon.temperature {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
}

.stat-icon.humidity {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.stat-info {
  flex: 1;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-bottom: 4rpx;
}

.stat-value-row {
  display: flex;
  align-items: baseline;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.stat-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-left: 4rpx;
}

.stat-trend {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-trend.up {
  background: rgba(82, 196, 26, 0.2);
}

.stat-trend.down {
  background: rgba(255, 77, 79, 0.2);
}

.stat-trend .iconfont {
  font-size: 24rpx;
}

.stat-trend.up .iconfont {
  color: #52c41a;
}

.stat-trend.down .iconfont {
  color: #ff4d4f;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.more-btn {
  font-size: 24rpx;
  color: #4a90d9;
}

.chart-tabs {
  display: flex;
  gap: 12rpx;
}

.chart-tab {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #999999;
  background: #f5f7fa;
  border-radius: 16rpx;
}

.chart-tab.active {
  background: #4a90d9;
  color: #ffffff;
}

.chart-container {
  height: 320rpx;
  margin-bottom: 16rpx;
}

.env-chart {
  width: 100%;
  height: 100%;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666666;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.temperature {
  background: #ff6b6b;
}

.legend-dot.humidity {
  background: #4facfe;
}

.sensor-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.sensor-card {
  padding: 20rpx;
}

.sensor-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sensor-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sensor-icon .iconfont {
  font-size: 28rpx;
  color: #ffffff;
}

.sensor-icon.temperature {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
}

.sensor-icon.humidity {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.sensor-icon.air {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.sensor-icon.light {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.sensor-icon.pressure {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.sensor-status {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.sensor-status.online {
  color: #52c41a;
}

.sensor-status.online .status-dot {
  background: #52c41a;
}

.sensor-status.offline {
  color: #999999;
}

.sensor-status.offline .status-dot {
  background: #d9d9d9;
}

.sensor-status.warning {
  color: #faad14;
}

.sensor-status.warning .status-dot {
  background: #faad14;
}

.sensor-body {
  margin-bottom: 16rpx;
}

.sensor-name {
  font-size: 26rpx;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.sensor-value-row {
  display: flex;
  align-items: baseline;
}

.sensor-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.sensor-unit {
  font-size: 22rpx;
  color: #999999;
  margin-left: 4rpx;
}

.sensor-footer {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sensor-range {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.range-label {
  font-size: 22rpx;
  color: #999999;
}

.range-value {
  font-size: 22rpx;
  color: #666666;
}

.sensor-progress {
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4a90d9 0%, #52c41a 100%);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.progress-fill.warning {
  background: linear-gradient(90deg, #faad14 0%, #ff4d4f 100%);
}

.alert-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.alert-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.alert-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.alert-icon.warning {
  background: rgba(250, 173, 20, 0.1);
}

.alert-icon.danger {
  background: rgba(255, 77, 79, 0.1);
}

.alert-icon .iconfont {
  font-size: 24rpx;
}

.alert-icon.warning .iconfont {
  color: #faad14;
}

.alert-icon.danger .iconfont {
  color: #ff4d4f;
}

.alert-content {
  flex: 1;
}

.alert-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.alert-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.alert-time {
  font-size: 22rpx;
  color: #999999;
}

.alert-desc {
  font-size: 24rpx;
  color: #666666;
  display: block;
  margin-bottom: 8rpx;
}

.alert-device {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

.alert-device .iconfont {
  font-size: 24rpx;
}

.alert-action {
  display: flex;
  align-items: center;
}

.action-btn {
  padding: 12rpx 24rpx;
  background: #4a90d9;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.summary-item {
  text-align: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.summary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #4a90d9;
  display: block;
  margin-bottom: 8rpx;
}

.summary-label {
  font-size: 22rpx;
  color: #999999;
}

.monitor-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.monitor-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.monitor-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8e8e8;
}

.monitor-icon.active {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
}

.monitor-icon .iconfont {
  font-size: 28rpx;
  color: #999999;
}

.monitor-icon.active .iconfont {
  color: #ffffff;
}

.monitor-name {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.empty-container .iconfont {
  font-size: 64rpx;
  color: #52c41a;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999999;
}

.iconfont {
  font-family: "iconfont";
}
