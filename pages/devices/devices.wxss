.container {
  padding-bottom: 120rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-input .iconfont {
  color: #999999;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 217, 0.3);
}

.add-btn .iconfont {
  color: #ffffff;
  font-size: 36rpx;
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding: 4rpx 0;
}

.tab-item {
  padding: 12rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666666;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.tab-item.active {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  color: #ffffff;
}

.tab-count {
  font-size: 22rpx;
  padding: 2rpx 10rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 12rpx;
}

.tab-item.active .tab-count {
  background: rgba(255, 255, 255, 0.3);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.section-count {
  font-size: 24rpx;
  color: #999999;
}

.device-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.device-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.device-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.device-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.device-icon .iconfont {
  font-size: 36rpx;
  color: #ffffff;
}

.device-icon.light {
  background: linear-gradient(135deg, #ffd93d 0%, #ff9a3c 100%);
}

.device-icon.sensor {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.device-icon.environment {
  background: linear-gradient(135deg, #6dd5ed 0%, #2193b0 100%);
}

.device-icon.security {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.device-icon.servo {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.device-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.device-status-dot.online {
  background: #52c41a;
  box-shadow: 0 0 8rpx rgba(82, 196, 26, 0.5);
}

.device-status-dot.offline {
  background: #d9d9d9;
}

.device-status-dot.warning {
  background: #faad14;
  box-shadow: 0 0 8rpx rgba(250, 173, 20, 0.5);
}

.device-body {
  margin-bottom: 16rpx;
}

.device-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 4rpx;
}

.device-room {
  font-size: 22rpx;
  color: #999999;
}

.device-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.device-status {
  font-size: 22rpx;
}

.device-status.online {
  color: #52c41a;
}

.device-status.offline {
  color: #999999;
}

.device-status.warning {
  color: #faad14;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
}

.fab-btn .iconfont {
  color: #ffffff;
  font-size: 48rpx;
}

.add-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
  position: relative;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 88rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #333333;
}

.form-picker .iconfont {
  color: #999999;
}

.scan-btn {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(8rpx);
  font-size: 26rpx;
  color: #4a90d9;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-footer .btn-primary,
.modal-footer .btn-secondary {
  flex: 1;
}

.iconfont {
  font-family: "iconfont";
}
