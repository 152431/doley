.container {
  padding-bottom: 120rpx;
}

.profile-header {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  margin: -24rpx -24rpx 24rpx -24rpx;
  padding: 48rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.edit-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-btn .iconfont {
  font-size: 32rpx;
  color: #ffffff;
}

.stats-card {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #4a90d9;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.stat-divider {
  width: 1rpx;
  background: #f0f0f0;
  margin: 0 16rpx;
}

.menu-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.menu-group {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-icon .iconfont {
  font-size: 28rpx;
  color: #ffffff;
}

.menu-icon.devices {
  background: linear-gradient(135deg, #4a90d9 0%, #357abd 100%);
}

.menu-icon.scenes {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.menu-icon.favorites {
  background: linear-gradient(135deg, #f5576c 0%, #f093fb 100%);
}

.menu-icon.message {
  background: linear-gradient(135deg, #ffd93d 0%, #ff9a3c 100%);
}

.menu-icon.security {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.menu-icon.privacy {
  background: linear-gradient(135deg, #6dd5ed 0%, #2193b0 100%);
}

.menu-icon.network {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.menu-icon.voice {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.menu-icon.theme {
  background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%);
}

.menu-icon.help {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
}

.menu-icon.about {
  background: linear-gradient(135deg, #d299c2 0%, #fef9d7 100%);
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.menu-badge {
  padding: 4rpx 16rpx;
  background: #f0f2f5;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #666666;
  margin-right: 12rpx;
}

.network-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.network-status.connected {
  color: #52c41a;
}

.network-status.connected .status-dot {
  background: #52c41a;
}

.network-status.disconnected {
  color: #ff4d4f;
}

.network-status.disconnected .status-dot {
  background: #ff4d4f;
}

.theme-name {
  font-size: 24rpx;
  color: #999999;
  margin-right: 12rpx;
}

.version {
  font-size: 24rpx;
  color: #999999;
  margin-right: 12rpx;
}

.menu-item .iconfont:last-child {
  font-size: 28rpx;
  color: #d9d9d9;
}

.logout-btn {
  margin-top: 40rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.logout-btn text {
  font-size: 28rpx;
  color: #ff4d4f;
}

.edit-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.edit-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.change-avatar {
  font-size: 24rpx;
  color: #4a90d9;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-footer .btn-primary,
.modal-footer .btn-secondary {
  flex: 1;
}

.iconfont {
  font-family: "iconfont";
}
