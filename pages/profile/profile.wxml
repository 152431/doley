<view class="container">
  <view class="profile-header">
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatar || '/assets/icons/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickname || '未登录'}}</text>
        <text class="user-id" wx:if="{{userInfo.id}}">ID: {{userInfo.id}}</text>
      </view>
    </view>
    <view class="edit-btn" bindtap="editProfile">
      <text class="iconfont icon-edit"></text>
    </view>
  </view>

  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{userStats.devices}}</text>
      <text class="stat-label">设备数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{userStats.scenes}}</text>
      <text class="stat-label">场景数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{userStats.automations}}</text>
      <text class="stat-label">自动化</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{userStats.days}}</text>
      <text class="stat-label">使用天数</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item" bindtap="goToDevices">
        <view class="menu-icon devices">
          <text class="iconfont icon-device"></text>
        </view>
        <text class="menu-text">我的设备</text>
        <text class="menu-badge">{{userStats.devices}}</text>
        <text class="iconfont icon-arrow-right"></text>
      </view>
      <view class="menu-item" bindtap="goToScenes">
        <view class="menu-icon scenes">
          <text class="iconfont icon-scene"></text>
        </view>
        <text class="menu-text">我的场景</text>
        <text class="menu-badge">{{userStats.scenes}}</text>
        <text class="iconfont icon-arrow-right"></text>
      </view>
      <view class="menu-item" bindtap="goToFavorites">
        <view class="menu-icon favorites">
          <text class="iconfont icon-heart"></text>
        </view>
        <text class="menu-text">收藏设备</text>
        <text class="iconfont icon-arrow-right"></text>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="goToMessageSettings">
        <view class="menu-icon message">
          <text class="iconfont icon-bell"></text>
        </view>
        <text class="menu-text">消息通知</text>
        <text class="iconfont icon-arrow-right"></text>
      </view>
      <view class="menu-item" bindtap="goToSecurity">
        <view class="menu-icon security">
          <text class="iconfont icon-security"></text>
        </view>
        <text class="menu-text">安全设置</text>
        <text class="iconfont icon-arrow-right"></text>
      </view>
      <view class="menu-item" bindtap="goToPrivacy">
        <view class="menu-icon privacy">
          <text class="iconfont icon-lock"></text>
        </view>
        <text class="menu-text">隐私设置</text>
        <text class="iconfont icon-arrow-right"></text>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="goToNetwork">
        <view class="menu-icon network">
          <text class="iconfont icon-wifi"></text>
        </view>
        <text class="menu-text">网络设置</text>
        <view class="network-status {{networkStatus.connected ? 'connected' : 'disconnected'}}">
          <text class="status-dot"></text>
          <text>{{networkStatus.connected ? '已连接' : '未连接'}}</text>
        </view>
        <text class="iconfont icon-arrow-right"></text>
      </view>
      <view class="menu-item" bindtap="goToVoice">
        <view class="menu-icon voice">
          <text class="iconfont icon-mic"></text>
        </view>
        <text class="menu-text">语音助手</text>
        <switch checked="{{settings.voiceEnabled}}" color="#4a90d9" bindchange="toggleVoice" />
      </view>
      <view class="menu-item" bindtap="goToTheme">
        <view class="menu-icon theme">
          <text class="iconfont icon-theme"></text>
        </view>
        <text class="menu-text">主题设置</text>
        <text class="theme-name">{{settings.themeName}}</text>
        <text class="iconfont icon-arrow-right"></text>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="goToHelp">
        <view class="menu-icon help">
          <text class="iconfont icon-help"></text>
        </view>
        <text class="menu-text">帮助与反馈</text>
        <text class="iconfont icon-arrow-right"></text>
      </view>
      <view class="menu-item" bindtap="goToAbout">
        <view class="menu-icon about">
          <text class="iconfont icon-info"></text>
        </view>
        <text class="menu-text">关于我们</text>
        <text class="version">v1.0.0</text>
        <text class="iconfont icon-arrow-right"></text>
      </view>
    </view>
  </view>

  <view class="logout-btn" bindtap="logout">
    <text>退出登录</text>
  </view>
</view>

<view class="edit-modal" wx:if="{{showEditModal}}" bindtap="hideEditModal">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">编辑资料</text>
      <text class="modal-close" bindtap="hideEditModal">×</text>
    </view>
    <view class="modal-body">
      <view class="avatar-section">
        <image class="edit-avatar" src="{{editForm.avatar || '/assets/icons/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="change-avatar" bindtap="changeAvatar">更换头像</view>
      </view>
      <view class="form-item">
        <text class="form-label">昵称</text>
        <input class="form-input" placeholder="请输入昵称" bindinput="onInputNickname" value="{{editForm.nickname}}" />
      </view>
      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" placeholder="请输入手机号" bindinput="onInputPhone" value="{{editForm.phone}}" />
      </view>
      <view class="form-item">
        <text class="form-label">邮箱</text>
        <input class="form-input" type="text" placeholder="请输入邮箱" bindinput="onInputEmail" value="{{editForm.email}}" />
      </view>
    </view>
    <view class="modal-footer">
      <view class="btn-secondary" bindtap="hideEditModal">取消</view>
      <view class="btn-primary" bindtap="saveProfile">保存</view>
    </view>
  </view>
</view>
